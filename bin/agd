#!/usr/bin/env python3
import argparse
import shutil
import subprocess
import os
import json
import pwd
import sys
import uuid
from pathlib import Path
from urllib.request import urlopen
from agd_lib import projects, store, tasks, workers, supervision, worker_skills, pr, relay, observability, reviewer, reviewer_runner, reviewer_timer, launcher, installer, omp_runtime


def parser():
    p = argparse.ArgumentParser(prog='agd')
    p.add_argument('--home')
    sub = p.add_subparsers(dest='command', required=True)
    init = sub.add_parser('init')
    init.add_argument('--backend', choices=('tmux', 'herdr'), required=True)
    start = sub.add_parser('start')
    start.add_argument('--backend', choices=('tmux', 'herdr'))
    doctor = sub.add_parser('doctor')
    installer_command = sub.add_parser('installer').add_subparsers(dest='installer_operation', required=True)
    installer_setup = installer_command.add_parser('setup')
    installer_setup.add_argument('--backend', choices=('tmux', 'herdr'), required=True)
    installer_command.add_parser('shell')
    omp = sub.add_parser('omp')
    omp.add_argument('omp_args', nargs=argparse.REMAINDER)
    doctor.add_argument('--harness', choices=('omp', 'cursor'), default='omp')
    doctor.add_argument('--backend', choices=('tmux', 'herdr'), default='tmux')
    project = sub.add_parser('project').add_subparsers(dest='operation', required=True)
    for action in ('add', 'register', 'inspect', 'refresh', 'remove', 'trust', 'approve'):
        op = project.add_parser(action)
        op.add_argument('id')
        if action == 'add':
            op.add_argument('--source', required=True)
            op.add_argument('--base', default='main')
        if action == 'register':
            op.add_argument('--path', required=True)
            op.add_argument('--base', default='main')
        if action == 'trust':
            op.add_argument('--instruction', required=True)
        if action == 'approve':
            op.add_argument('--action', required=True, choices=('delete-clone',))
            op.add_argument('--instruction', required=True)
        if action == 'remove':
            op.add_argument('--delete-clone', action='store_true')
            op.add_argument('--approval')
    project.add_parser('list')
    task = sub.add_parser('task').add_subparsers(dest='operation', required=True)
    create = task.add_parser('create')
    create.add_argument('id')
    create.add_argument('--project', required=True)
    create.add_argument('--brief', required=True)
    create.add_argument('--base')
    create.add_argument('--kind', choices=('ship', 'scout'), default='ship')
    create.add_argument('--harness', choices=('omp', 'cursor'), default='omp')
    create.add_argument('--profile')
    create.add_argument('--skill-mode', choices=('profile', 'curated', 'none'),
                        default='profile')
    create.add_argument('--skill', action='append', default=[])
    status = task.add_parser('status')
    status.add_argument('id')
    task.add_parser('list')
    reconcile = task.add_parser('reconcile')
    reconcile.add_argument('id')
    for action in ('ready', 'approve', 'land', 'cleanup'):
        op = task.add_parser(action)
        op.add_argument('id')
        if action == 'ready':
            op.add_argument('--report', required=True)
        if action == 'approve':
            op.add_argument('--action', required=True, choices=('local-merge', 'publish', 'pr-publish', 'discard', 'unattended'))
            op.add_argument('--target', required=True)
            op.add_argument('--instruction', required=True)
        if action == 'land':
            op.add_argument('--approval', required=True)
        if action == 'cleanup':
            op.add_argument('--discard', action='store_true')
            op.add_argument('--approval')
    publication = task.add_parser('publication-record')
    publication.add_argument('id')
    for option in ('approval', 'remote', 'branch', 'url', 'evidence'):
        publication.add_argument('--'+option, required=True)
    worker = sub.add_parser('worker').add_subparsers(dest='operation', required=True)
    skills = worker.add_parser('skills').add_subparsers(dest='skill_operation', required=True)
    skills.add_parser('list')
    profiles = worker.add_parser('profiles').add_subparsers(dest='profile_operation', required=True)
    profiles.add_parser('list')
    for action in ('launch', 'run', 'event', 'context', 'inspect', 'send', 'inbox', 'complete', 'interrupt', 'stop', 'relaunch',
                   'publish-pr', 'verify-pr', 'relay-poll', 'relay-reply'):
        op = worker.add_parser(action)
        op.add_argument('id')
        if action == 'launch':
            op.add_argument('--backend', choices=('tmux', 'herdr'))
            op.add_argument('--unattended', action='store_true')
            op.add_argument('--approval')
            op.add_argument('--pr-grant')
        if action in ('run', 'event', 'context'):
            op.add_argument('--incarnation', required=True)
        if action == 'event':
            op.add_argument('--kind', required=True)
            op.add_argument('--key', required=True)
            op.add_argument('--message', required=True)
        if action == 'send':
            op.add_argument('--file', required=True)
        if action == 'complete':
            op.add_argument('message_id')
            op.add_argument('--incarnation', required=True)
            op.add_argument('--status', choices=('done', 'failed'), required=True)
        if action == 'publish-pr':
            op.add_argument('--incarnation', required=True)
            op.add_argument('--grant', required=True)
            op.add_argument('--title', required=True)
            op.add_argument('--body', required=True)
        if action == 'verify-pr':
            op.add_argument('--incarnation', required=True)
            op.add_argument('--grant', required=True)
            op.add_argument('--report', required=True)
        if action in ('relay-poll', 'relay-reply'):
            op.add_argument('--incarnation', required=True)
            op.add_argument('--grant', required=True)
        if action == 'relay-reply':
            op.add_argument('--lease', required=True)
            op.add_argument('--action', choices=('start', 'complete', 'cancelled'), required=True)
            op.add_argument('--payload')
    decision = sub.add_parser('decision').add_subparsers(dest='operation', required=True)
    resolve = decision.add_parser('resolve')
    resolve.add_argument('id')
    resolve.add_argument('key')
    resolve.add_argument('--answer', required=True)
    session = sub.add_parser('session').add_subparsers(dest='operation', required=True)
    start = session.add_parser('start')
    start.add_argument('--owner-pid', type=int, required=True)
    start.add_argument('--owner-start', required=True)
    start.add_argument('--generation', required=True)
    session.add_parser('status')
    session.add_parser('reconcile')
    events = sub.add_parser('events').add_subparsers(dest='operation', required=True)
    events.add_parser('list')
    ack = events.add_parser('acknowledge')
    ack.add_argument('ids', nargs='+')
    observability_command = sub.add_parser('observability').add_subparsers(dest='operation', required=True)
    for action in ('enable', 'start', 'stop', 'status', 'disable'):
        observability_command.add_parser(action)
    central = observability_command.add_parser('central')
    central.add_argument('omp_args', nargs=argparse.REMAINDER)
    reviewer_p = sub.add_parser('reviewer').add_subparsers(dest='reviewer_op', required=True)
    run_p = reviewer_p.add_parser('run'); run_p.add_argument('--timer', action='store_true'); run_p.add_argument('--retrospective-review-run', type=lambda value: str(uuid.UUID(value)), action='append', default=[])
    reviewer_p.add_parser('status')
    reports = reviewer_p.add_parser('reports').add_subparsers(dest='report_op', required=True)
    reports.add_parser('list'); reports.add_parser('show').add_argument('report_id')
    proposals = reviewer_p.add_parser('proposals').add_subparsers(dest='proposal_op', required=True)
    proposals.add_parser('list'); proposals.add_parser('show').add_argument('proposal_id')
    dispose = proposals.add_parser('dispose'); dispose.add_argument('proposal_id'); dispose.add_argument('--status', required=True, choices=('accepted', 'rejected', 'deferred', 'superseded')); dispose.add_argument('--reason'); dispose.add_argument('--replacement')
    timer_p = reviewer_p.add_parser('timer').add_subparsers(dest='timer_op', required=True)
    for action in ('enable', 'disable', 'status'): timer_p.add_parser(action)
    return p

def parse_args(argv=None):
    values = list(sys.argv[1:] if argv is None else argv)
    index = 0
    while index < len(values):
        argument = values[index]
        if argument == '--home':
            index += 2
            continue
        if argument.startswith('--home='):
            index += 1
            continue
        if argument == 'omp':
            parsed = parser().parse_args(values[:index + 1])
            parsed.omp_args = values[index + 1:]
            return parsed
        break
    return parser().parse_args(values)


def main(args):
    home = store.home(args.home)
    mutation = (args.command in ('init', 'installer') or
                args.command == 'project' and args.operation not in ('list', 'inspect') or
                args.command == 'task' and args.operation not in ('list', 'status') or
                args.command == 'worker' and args.operation not in ('inspect', 'context', 'inbox', 'skills', 'profiles') or
                args.command == 'decision' or
                args.command == 'session' and args.operation == 'reconcile' or
                args.command == 'events' and args.operation == 'acknowledge' or
                args.command == 'observability' and args.operation != 'status')
    if mutation:
        worker_scoped = (args.command == 'worker' and args.operation in ('run', 'event', 'complete', 'publish-pr', 'verify-pr',
                                                                           'relay-poll', 'relay-reply') or
                         args.command == 'task' and args.operation == 'ready')
        store.require_owner(home, worker_scoped)
    if args.command == 'omp':
        omp_runtime.validate_native_args(args.omp_args)
        executable = omp_runtime.executable(home)
        os.chdir(home)
        os.execvpe(executable, [executable, *args.omp_args],
                   omp_runtime.environment(home, os.environ))
    if args.command == 'observability' and args.operation == 'central':
        argv, env, warning = observability.central_argv(home, args.omp_args)
        if warning:
            print(warning, file=sys.stderr)
        os.chdir(home)
        os.execvpe(argv[0], argv, env)
    if args.command == 'init':
        if home == Path(__file__).resolve().parents[1]:
            fresh = not any((home/name).exists() or (home/name).is_symlink()
                            for name in ('config', 'projects', 'data', 'state'))
        else:
            fresh = not home.exists() or not any(home.iterdir())
        checkout_home = home == Path(__file__).resolve().parents[1]
        with store.lock(home):
            lock_only = all(path.name == 'mutation.lock' for path in (home/'state').iterdir())
            if checkout_home:
                still_fresh = fresh and lock_only and not any(
                    (home/name).exists() or (home/name).is_symlink()
                    for name in ('config', 'projects', 'data'))
            else:
                still_fresh = fresh and lock_only and all(
                    path.name == 'state' for path in home.iterdir())
            if not still_fresh:
                raise store.Refusal('fresh non-symlink launcher home required')
            for name in ('config', 'projects', 'data/projects', 'data/tasks', 'state'):
                (home/name).mkdir(parents=True, exist_ok=True, mode=0o700)
            store.atomic_json(home/'data'/'home.json', {'schema': 1, 'home_id': str(uuid.uuid4())})
            launcher.initialize(home, args.backend)
            worker_skills.seed_defaults(home)
        return {'home': str(home)}
    if args.command == 'start':
        inherited = dict(os.environ)
        active = launcher.active_backend(home, inherited)
        if args.backend is not None and active is not None and args.backend != active:
            raise store.Refusal('explicit backend differs from active central')
        selected = args.backend or active or launcher.resolve_backend(home, None)
        dependencies = installer.validate_dependencies(home, store.run)
        if 'omp' not in dependencies or selected == 'herdr' and 'herdr' not in dependencies:
            raise store.Refusal('selected launcher dependency is unavailable')
        if selected == 'tmux':
            store.run(['tmux', '-V'])
        target = launcher.prepare_start(home, selected, inherited,
                                        launcher._backend_create, launcher._backend_inspect,
                                        launcher._backend_attach)
        os.execvpe(target.attach_argv[0], target.attach_argv, target.env)
    if args.command == 'installer':
        if args.installer_operation == 'shell':
            shell = os.environ.get('SHELL') or '/bin/sh'
            os.chdir(home)
            os.execvpe(shell, [shell, '-i'], os.environ)
        def fetch_json(url):
            with urlopen(url) as response:
                return json.load(response)
        def stream_url(url):
            with urlopen(url) as response:
                yield from iter(lambda: response.read(1024 * 1024), b'')
        def prompt(message):
            color = sys.stderr.isatty() and os.environ.get('TERM', 'dumb') != 'dumb' and 'NO_COLOR' not in os.environ
            label = f'\033[36m{message}\033[0m' if color else message
            print(f'\n{label} [y/N] ', end='', file=sys.stderr, flush=True)
            return input().strip().lower() in ('y', 'yes')
        return installer.setup(home, args.backend, prompt, fetch_json, stream_url, store.run)
    if args.command == 'doctor':
        names = ['git', 'treehouse', 'omp' if args.harness == 'omp' else 'cursor-agent',
                 args.backend]
        found = {}
        for name in names:
            binary = shutil.which(name)
            if not binary:
                found[name] = {'available': False, 'reason': f'install {name} independently'}
                continue
            version = subprocess.run([binary, '-V' if name == 'tmux' else '--version'],
                                     stdin=subprocess.DEVNULL, capture_output=True,
                                     text=True, timeout=10)
            text = (version.stdout or version.stderr).strip()
            compatible = version.returncode == 0 and (name != 'treehouse' or text == 'v3.1.6')
            found[name] = {'available': compatible, 'version': text[:120],
                           'path': binary, 'reason': '' if compatible else
                           ('use pinned Treehouse v3.1.6' if name == 'treehouse' else 'version check failed')}
        return {'dependencies': found, 'ready': all(row['available'] for row in found.values()),
                'approval': 'Explicit project trust is required for Cursor; unattended workers need scoped approval.'}
    if args.command == 'project':
        if args.operation == 'list':
            return [projects.read(home, f.stem) for f in sorted((home/'data'/'projects').glob('*.json')) if not f.name.endswith('.approval.json')]
        if args.operation == 'add':
            return projects.add(home, args.id, args.source, args.base)
        if args.operation == 'register':
            return projects.register(home, args.id, args.path, args.base)
        if args.operation == 'inspect':
            return projects.read(home, args.id)
        if args.operation == 'refresh':
            return projects.refresh(home, args.id)
        if args.operation == 'remove':
            return projects.remove(home, args.id, args.delete_clone, args.approval)
        if args.operation == 'trust':
            return projects.trust(home, args.id, args.instruction)
        if args.operation == 'approve':
            return projects.approve(home, args.id, args.action, args.instruction)
    if args.command == 'task':
        if args.operation == 'create':
            return tasks.create(
                home, args.id, args.project, args.brief, args.base, args.kind,
                harness=args.harness, profile=args.profile,
                skill_mode=args.skill_mode, skills=tuple(args.skill))
        if args.operation == 'status':
            return dict(tasks.read(home, args.id), open_decisions=supervision.decisions(home, args.id))
        if args.operation == 'list':
            return [tasks.read(home, f.parent.name) for f in sorted((home/'data'/'tasks').glob('*/task.json'))]
        if args.operation == 'reconcile':
            return tasks.reconcile_allocation(home, args.id)
        if args.operation == 'ready':
            return tasks.ready(home, args.id, args.report)
        if args.operation == 'approve':
            return (tasks.grant_pr_publish(home, args.id, args.target, args.instruction)
                    if args.action == 'pr-publish' else
                    tasks.approve(home, args.id, args.action, args.target, args.instruction))
        if args.operation == 'land':
            return tasks.land(home, args.id, args.approval)
        if args.operation == 'cleanup':
            return tasks.cleanup(home, args.id, args.discard, args.approval)
        if args.operation == 'publication-record':
            return tasks.publication_record(home, args.id, args.approval, args.remote,
                                            args.branch, args.url, args.evidence)
    if args.command == 'worker':
        if args.operation == 'skills':
            return worker_skills.catalog(home)
        if args.operation == 'profiles':
            return worker_skills.profiles(home)
        if args.operation == 'context':
            return workers.context(home, args.id, args.incarnation)
        if args.operation == 'launch':
            return workers.launch(home, args.id, args.backend, args.unattended,
                                  args.approval, args.pr_grant)
        if args.operation == 'publish-pr':
            title, body = pr.publication_texts(home, args.id, args.incarnation, args.grant,
                                               args.title, args.body)
            return pr.publish(home, args.id, args.incarnation, args.grant, title, body)
        if args.operation == 'verify-pr':
            return pr.verify_and_ready(home, args.id, args.incarnation, args.grant, Path(args.report))
        if args.operation == 'relay-poll':
            task = tasks.read(home, args.id)
            return relay.poll(home, task, tasks.authorize_pr_publish(home, task, args.grant), args.incarnation)
        if args.operation == 'relay-reply':
            task = tasks.read(home, args.id)
            return relay.reply_file(home, task, tasks.authorize_pr_publish(home, task, args.grant),
                                    args.incarnation, args.lease, args.action, args.payload)
        if args.operation == 'run':
            return workers.run_worker(home, args.id, args.incarnation)
        if args.operation == 'event':
            return workers.event(home, args.id, args.incarnation, args.kind, args.key, args.message)
        if args.operation == 'inspect':
            return workers.inspect(home, args.id)
        if args.operation == 'send':
            return workers.send(home, args.id, args.file)
        if args.operation == 'inbox':
            return workers.inbox(home, args.id)
        if args.operation == 'complete':
            return workers.complete(
                home, args.id, args.message_id, args.incarnation,
                args.status, sys.stdin.read())
        if args.operation == 'interrupt':
            return workers.interrupt(home, args.id)
        if args.operation == 'stop':
            return workers.stop(home, args.id)
        if args.operation == 'relaunch':
            return workers.relaunch(home, args.id)
    if args.command == 'reviewer':
        if args.reviewer_op == 'run':
            if args.timer and args.retrospective_review_run: raise store.Refusal('timer runs cannot be retrospective')
            if args.timer: return reviewer_runner.launch_timer(home)
            selected = tuple(args.retrospective_review_run)
            return reviewer_runner.run_native_reviewer(
                home, reviewer.enqueue_intent(
                    home, kind='retrospective' if selected else 'manual',
                    retrospective_review_run_ids=selected))
        if args.reviewer_op == 'status':
            return {'timer': reviewer_timer._read_record(home), 'runs': len(list(reviewer.paths(home)['receipts'].glob('*.json')))}
        if args.reviewer_op == 'reports':
            if args.report_op == 'list': return [reviewer._read_json(p) for p in sorted(reviewer.paths(home)['reports'].glob('*.json'))]
            return reviewer._read_json(reviewer.report_path(home, args.report_id))
        if args.reviewer_op == 'proposals':
            if args.proposal_op == 'dispose': return reviewer.dispose(home, args.proposal_id, args.status, args.reason, args.replacement, {'uid': os.getuid(), 'identity': pwd.getpwuid(os.getuid()).pw_name})
            rows = reviewer.list_proposals(home) if args.proposal_op == 'list' else [reviewer.read_proposal(home, args.proposal_id)]
            rendered = [{**row, 'current': reviewer.read_triage(home, row['proposal_id'])['current'], 'history': reviewer.read_triage(home, row['proposal_id'])['history']} for row in rows]
            return rendered if args.proposal_op == 'list' else rendered[0]
        if args.timer_op == 'status': return reviewer_timer._read_record(home)
        if args.timer_op == 'enable': return reviewer_timer.enable(home, reviewer.read_config(home), source_cli=str(Path(__file__).resolve()))
        return reviewer_timer.disable(home)
    if args.command == 'decision':
        return supervision.resolve(home, args.id, args.key, args.answer)
    if args.command == 'session':
        if args.operation == 'start':
            return supervision.watch(home, args.owner_pid, args.owner_start, args.generation)
        if args.operation == 'status':
            return supervision.status(home)
        if args.operation == 'reconcile':
            return supervision.reconcile(home)
    if args.command == 'events':
        if args.operation == 'list':
            return supervision.pending(home)
        if args.operation == 'acknowledge':
            return supervision.acknowledge(home, args.ids)
    if args.command == 'observability':
        return getattr(observability, args.operation)(home)
    raise ValueError('unsupported command')


if __name__ == '__main__':
    try:
        result = main(parse_args())
        if result is not None:
            print(json.dumps(result, indent=2 if sys.stdout.isatty() else None))
    except (ValueError, store.Refusal, store.DependencyError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(2 if isinstance(error, ValueError) else 4 if isinstance(error, store.DependencyError) else 3)
